{
  "name": "product-service",
  "version": "1.0.0",
  "description": "Modular Node.js ecommerce backend with DynamoDB and Redis caching",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "seed": "node scripts/seed.js run",
    "seed:force": "node scripts/seed.js run --force",
    "seed:reset": "node scripts/seed.js reset"
  },
  "keywords": [
    "ecommerce",
    "api",
    "dynamodb",
    "redis"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-lambda": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "aws-jwt-verify": "^4.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.3",
    "dotenv": "^16.4.7",
    "dynamoose": "^4.0.4",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.1",
    "joi": "^18.0.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@sentry/node": "^8.0.0",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "jest": "^29.7.0"
  }
}
