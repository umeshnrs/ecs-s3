# DynamoDB Configuration
DYNAMODB_DATABASE_NAME=products

# Application Configuration
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
AUTO_MIGRATE=true
AUTO_SEED=true

# Frontend Configuration
VITE_API_URL=http://localhost:8080