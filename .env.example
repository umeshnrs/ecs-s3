# Docker Compose Environment Variables
# Redis Configuration
REDIS_ENABLED=true
REDIS_ENDPOINT=redis
REDIS_PORT=6379
REDIS_AUTH_TOKEN=1b81b362-fa95-4f04-9e50-99c2c901a884

# AWS Configuration
AWS_REGION=ap-south-1
